# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - never commit real credentials.

# MySQL connection (used by database/setup.sh, the ETL and the API)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_data_platform
DB_USER=edp_app
DB_PASSWORD=change-me

# Browser origin(s) allowed to call the API (comma separated)
FRONTEND_ORIGIN=http://localhost:5173
